      { "value": "wolf", "label": "Wolf" }, { "value": "bear", "label": "Bear" }, { "value": "raccoon", "label": "Raccoon" },
      { "value": "cat", "label": "Cat" }, { "value": "hedgehog", "label": "Hedgehog" }, { "value": "mouse", "label": "Mouse" },
