{
  "schema": "keel.jsmodule@2",
  "id": "lit-finish",
  "version": "0.1.0",
  "entry": "src/index.ts",
  "license": "MIT",
  "summary": "The finish a lit full-colour keel/lit stage needs to read as real: ambient occlusion from depth, aerial haze lit toward the sun, sunlight through leaves, colour muted and varied across the world, TAA, bloom, a filmic tone map (AgX, PBR Neutral, ACES) and a light grade. The realism look's counterpart to voxel-dither.",
  "category": "render",
  "owner": {
    "org": "keel-web3",
    "group": "graphics"
  },
  "inputs": [
    {
      "key": "tonemap",
      "label": "Tone map",
      "type": "select",
      "required": false,
      "options": [
        {
          "value": "agx",
          "label": "AgX"
        },
        {
          "value": "neutral",
          "label": "PBR Neutral"
        },
        {
          "value": "aces",
          "label": "ACES"
        }
      ],
      "default": "agx"
    },
    {
      "key": "exposure",
      "label": "Exposure",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 16,
      "step": 0.05,
      "control": "slider",
      "default": 1
    },
    {
      "key": "ao",
      "label": "Ambient occlusion",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "default": 0.8
    },
    {
      "key": "aoRadius",
      "label": "AO radius",
      "type": "number",
      "required": false,
