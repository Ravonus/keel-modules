      { "value": "meerkat", "label": "Meerkat" }, { "value": "squirrel", "label": "Squirrel" }, { "value": "redpanda", "label": "Red panda" },
      { "value": "koala", "label": "Koala" }, { "value": "macaque", "label": "Macaque" }, { "value": "monkey", "label": "Monkey" },
      { "value": "sloth", "label": "Sloth" }, { "value": "songbird", "label": "Songbird" }, { "value": "crow", "label": "Crow" },
