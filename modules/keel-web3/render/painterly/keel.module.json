{
  "schema": "keel.jsmodule@2",
  "id": "painterly",
  "version": "0.1.0",
  "entry": "src/index.ts",
  "license": "MIT",
  "summary": "A lit keel/lit stage painted as an oil painting: smoothed along its structure (an anisotropic Kuwahara filter on the structure tensor), strokes stamped along the form from the mesh's own normals and depth, canvas grain, edge darkening and a varnish grade. The stroke placement and the canvas weave come from a seed.",
  "category": "render",
  "owner": {
    "org": "keel-web3",
    "group": "graphics"
  },
  "inputs": [
    {
      "key": "stroke",
      "label": "Brush size",
      "type": "number",
      "required": false,
      "min": 2,
      "max": 12,
      "step": 0.5,
      "unit": "px",
      "control": "slider",
      "help": "The brush's radius in painted pixels.",
      "default": 5
    },
    {
      "key": "direction",
      "label": "Follow the form",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "help": "How far strokes follow the shape rather than the colour.",
      "default": 1
    },
    {
      "key": "strokes",
      "label": "Strokes",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "help": "How much of the picture is stamped strokes; 0 is the smoothed base alone.",
      "default": 1
    },
    {
      "key": "grain",
      "label": "Canvas grain",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "default": 0.25
    },
    {
      "key": "edge",
      "label": "Edge darkening",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "default": 0.5
    },
    {
      "key": "grade",
      "label": "Varnish",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "control": "slider",
      "default": 0.6
    },
    {
      "key": "exposure",
      "label": "Exposure",
      "type": "number",
      "required": false,
      "placement": "advanced",
      "min": 0,
      "max": 16,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "resolution",
      "label": "Paint resolution",
      "type": "number",
      "required": false,
      "placement": "advanced",
      "min": 0.25,
      "max": 1,
      "step": 0.05,
      "help": "Painted pixels for each frame pixel.",
      "default": 0.5
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "number",
      "required": false,
      "placement": "advanced",
      "min": 0,
      "max": 2147483647,
      "step": 1,
      "help": "Which placement of strokes and weave of canvas.",
      "default": 1
    }
  ]
}
