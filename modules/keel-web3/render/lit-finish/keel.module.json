      "type": "number",
      "required": false,
      "min": 0,
      "max": 0.5,
      "step": 0.001,
      "control": "slider",
      "help": "Air per metre; 0 draws none.",
      "default": 0.012
    },
    {
      "key": "hazeGlow",
      "label": "Haze glow",
      "type": "number",
      "required": false,
      "placement": "advanced",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 0.9
    },
    {
      "key": "saturation",
      "label": "Saturation",
      "type": "number",
      "required": false,
